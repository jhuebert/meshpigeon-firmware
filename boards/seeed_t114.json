{
  "build": {
    "arduino": {
      "ldscript": "nrf52840_s140_v6.ld"
    },
    "bsp": {
      "name": "adafruit"
    },
    "core": "nRF5",
    "cpu": "cortex-m4",
    "extra_flags": "-DNRF52840_XXAA -DARDUINO_NRF52840_FEATHER -DUSE_TINYUSB",
    "f_cpu": "64000000L",
    "mcu": "nrf52840",
    "variant": "feather_nrf52840_express",
    "zephyr": {
      "variant": "nrf52840dk_nrf52840"
    },
    "softdevice": {
      "sd_flags": "-DS140",
      "sd_name": "s140",
      "sd_version": "6.1.1",
      "sd_fwid": "0x00B6"
    },
    "bootloader": {
      "settings_addr": "0xFF000"
    }
  },
  "connectivity": [
    "bluetooth"
  ],
  "debug": {
    "default_tools": [
      "jlink"
    ],
    "jlink_device": "nRF52840_xxAA",
    "onboard_tools": [
      "cmsis-dap",
      "jlink"
    ],
    "svd_path": "nrf52840.svd"
  },
  "frameworks": [
    "arduino"
  ],
  "name": "Seeed SenseCAP T114 (nRF52840 + SX1262)",
  "upload": {
    "maximum_ram_size": 262144,
    "maximum_size": 1048576,
    "protocol": "jlink",
    "protocols": [
      "jlink",
      "nrfutil",
      "blackmagic",
      "cmsis-dap"
    ]
  },
  "url": "https://www.seeedstudio.com/SenseCAP-T114-LoRaWAN-Tracker-p-5812.html",
  "vendor": "Seeed"
}
